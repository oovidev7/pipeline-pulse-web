# Password required to access the dashboard (see /login).
SITE_PASSWORD=

# Long random secret used to sign the login session cookie. Generate with: openssl rand -hex 32
ADMIN_SECRET=

# Attio API key with read access to deals, people, and workspace_members.
ATTIO_API_KEY=

# Attio workspace slug (defaults to "sentrum" if unset).
ATTIO_WORKSPACE_SLUG=

# Google OAuth 2.0 Web application Client ID (Gmail + Calendar).
GOOGLE_CLIENT_ID=

# Google OAuth 2.0 Web application Client Secret.
GOOGLE_CLIENT_SECRET=

# Google OAuth refresh token for a single shared account (used if the OGI/DANNY tokens below are not set).
GOOGLE_REFRESH_TOKEN=

# Optional: refresh token for a second calendar to merge into Upcoming Calls (e.g. "Ogi").
GOOGLE_REFRESH_TOKEN_OGI=

# Optional: refresh token for a second calendar to merge into Upcoming Calls (e.g. "Danny").
GOOGLE_REFRESH_TOKEN_DANNY=

# Slack bot token (starts with xoxb-) with channel read access, invited to the data channel.
SLACK_BOT_TOKEN=

# Slack channel ID (not name) to read weekly snapshot JSON posts from, e.g. "#sentrum-pulse-data-v2".
SLACK_CHANNEL_ID=

# Anthropic API key used for the "Suggest next action" feature.
ANTHROPIC_API_KEY=
